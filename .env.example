# AI SRE Autonomous Backend Configuration
# Port for AI SRE Backend (default 5050 to avoid clash with PulseShop Gateway on 4000)
PORT=5050
NODE_ENV=development

# Real monitoring mode (set to true only for offline mock demonstrations)
DEMO_MODE=false

# Remediation Feature Flags
ENABLE_DOCKER_REMEDIATION=true
ENABLE_CIRCUIT_BREAKER=true
ENABLE_RETRY_CONTROL=true
DOCKER_EXEC_TIMEOUT_MS=15000

# Operator Secret for ASK_FIRST Human Approval Authorization
OPERATOR_SECRET_TOKEN=sre-operator-secret-2026

# Google Gemini AI Configuration
# When unset, system operates on deterministic heuristic planner fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=10000

# Monitored Services (PulseShop default ports: 4000, 4001, 4002)
GATEWAY_SERVICE_URL=http://localhost:4000
ORDERS_SERVICE_URL=http://localhost:4001
PAYMENTS_SERVICE_URL=http://localhost:4002

# Allowed Docker Containers for Safe Remediation (Allowlist)
DOCKER_ALLOWED_CONTAINERS=gateway-service,orders-service,payments-service,pulseshop-gateway,pulseshop-orders,pulseshop-payments

# Monitoring Intervals
SCRAPE_INTERVAL_MS=3000
SYNTHETIC_INTERVAL_MS=5000
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
